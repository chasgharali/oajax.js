{
  "name": "oajax.js",
  "version": "2.0.0",
  "description": "Offline-first requests on top of fetch: reads fall back to a cached copy when the network fails, writes go to a persisted, ordered outbox and replay with idempotency keys when the connection returns. Zero dependencies; optional jQuery-style $oajax wrapper for v1 users.",
  "keywords": [
    "offline-first",
    "offline",
    "outbox",
    "background-sync",
    "fetch",
    "ajax",
    "cordova",
    "capacitor",
    "pwa",
    "jquery"
  ],
  "license": "MIT",
  "author": "Asghar Ali",
  "homepage": "https://github.com/chasgharali/oajax.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chasgharali/oajax.js.git"
  },
  "bugs": {
    "url": "https://github.com/chasgharali/oajax.js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/oajax.min.js",
  "jsdelivr": "./dist/oajax.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jquery": {
      "import": {
        "types": "./dist/jquery.d.ts",
        "default": "./dist/jquery.js"
      },
      "require": {
        "types": "./dist/jquery.d.cts",
        "default": "./dist/jquery.cjs"
      }
    },
    "./oajax.min.js": "./dist/oajax.min.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "jquery": [
        "./dist/jquery.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack . --profile node16 --exclude-entrypoints ./oajax.min.js",
    "check": "npm run typecheck && npm run test && npm run build && npm run lint:package",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
